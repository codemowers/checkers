digraph MenuFlow {
  graph [rankdir=TB, label="CHECKERS — menu flows", labelloc=t, fontname="sans-serif", fontsize=20,
    bgcolor="#f8fafc", pad=0.3, nodesep=0.4, ranksep=0.5, pack=true, packmode="array_u2"];
  node [shape=box, style=filled, fillcolor="#dbeafe", color="#2563eb", fontname="sans-serif", fontsize=11, margin="0.15,0.10"];
  edge [color="#64748b", fontname="sans-serif", fontsize=10];

  // Independent panels keep return paths local instead of crossing the whole chart.
  subgraph cluster_identity {
    label="1. Identity — lobby and seated players only"; color="#cbd5e1";
    identity [label="Open page", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    signed [label="Signed in?", shape=diamond, fillcolor="#fef3c7", color="#b45309"];
    account [label="Account name\nHide Change name and Log in"];
    generated [label="Use saved or autogenerated name\nShow Change name and optional Log in"];
    edit [label="Edit name → Save / Cancel", shape=parallelogram, fillcolor="#ede9fe", color="#7c3aed"];
    login [label="Log in → return to current page", shape=parallelogram, fillcolor="#ede9fe", color="#7c3aed"];
    identity -> signed;
    signed -> account [label="Yes"];
    signed -> generated [label="No"];
    generated -> edit [label="Change name"];
    generated -> login [label="Log in (when enabled)"];
  }

  subgraph cluster_auth {
    label="2. Authentication policy"; color="#cbd5e1";
    auth [shape=plain, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#fef3c7"><B>AUTH_MODE</B></TD><TD BGCOLOR="#dbeafe"><B>Open a game</B></TD><TD BGCOLOR="#ede9fe"><B>Join a game link</B></TD></TR>
        <TR><TD>anon</TD><TD>Automatic name</TD><TD>Automatic name; no login</TD></TR>
        <TR><TD>optional</TD><TD>Automatic name or login</TD><TD>Automatic name or login</TD></TR>
        <TR><TD>invite</TD><TD>Login required</TD><TD>Automatic name or login</TD></TR>
        <TR><TD>enforced</TD><TD>Login required</TD><TD>Login required to play</TD></TR>
      </TABLE>
    >];
    defaults [shape=note, fillcolor="#f1f5f9", color="#94a3b8",
      label="Unset: OIDC configured → enforced; otherwise anon\nSpectator links use SPECTATOR_MODE independently"];
    auth -> defaults [style=invis];
  }

  subgraph cluster_play {
    label="3. Play"; color="#cbd5e1";
    home [label="Home", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    opening [label="Opening board\nSwitch English / international rules"];
    waiting [label="Make opening move\nMatch a player or wait for one"];
    share [label="Invite (waiting host only)\nShare sheet / clipboard", shape=parallelogram, fillcolor="#ede9fe", color="#7c3aed"];
    playing [label="Playing\nTop-right Share game if spectating enabled"];
    done [label="Finished / Quit game", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    again [label="New opening board\nInvite-mode guests log in first"];
    home -> opening;
    opening -> waiting;
    waiting -> share [label="Waiting: no expiry"];
    waiting -> playing [label="Player joins / computer chosen"];
    share -> playing [label="Recipient chooses Play against host"];
    playing -> done;
    done -> again [label="Play again / quit succeeds"];
    policy [shape=note, fillcolor="#f1f5f9", color="#94a3b8",
      label="invite auth mode: no automatic matchmaking\nPlay computer instead: ENABLE_COMPUTER=true\nLive viewing: SPECTATOR_MODE=invite"];
    again -> policy [style=invis];
  }

  subgraph cluster_view {
    label="4. Spectating and demos"; color="#cbd5e1";
    link [label="Open invitation\n/games/<id>", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    gate [label="SPECTATOR_MODE?", shape=diamond, fillcolor="#fef3c7", color="#b45309"];
    blocked [label="Automatically take open opponent seat\nLogin first when required"];
    watch [label="Watch live game\nSlow orbit; starts from Black's side\nNo identity buttons; board is view-only"];
    demo [label="Home → Watch demo\nENABLE_DEMO=true", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    controls [label="Computer vs computer\nPause / Resume\nWatch another game after result"];
    back [label="Back to play", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    link -> gate;
    gate -> watch [label="invite"];
    gate -> blocked [label="disabled"];
    demo -> controls;
    take_seat [label="Play against <host>\nShown when opponent seat is open"];
    seated [label="Playing as opponent", shape=ellipse, fillcolor="#dcfce7", color="#15803d"];
    watch -> take_seat [label="Choose to join"];
    blocked -> seated [label="Seat available"];
    take_seat -> seated;
    controls -> back;
  }

  legend [shape=note, fillcolor="#f1f5f9", color="#94a3b8", label="Legend\nGreen oval: entry / exit\nBlue rectangle: screen / action\nAmber diamond: decision\nPurple parallelogram: input / output\nRed oval: unavailable"];
}
